{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smart-fnb-be.onrender.com/api/v1",
        "EXPO_PUBLIC_REALTIME_PATH": "/socket.io",
        "EXPO_PUBLIC_DISPLAY_PAIRING_MOCK": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smart-fnb-be.onrender.com/api/v1",
        "EXPO_PUBLIC_REALTIME_PATH": "/socket.io",
        "EXPO_PUBLIC_DISPLAY_PAIRING_MOCK": "false"
      }
    }
  }
}
