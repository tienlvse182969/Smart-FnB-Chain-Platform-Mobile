{
  "expo": {
    "name": "Smart F&B",
    "slug": "smart_fnb",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "smartfnb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.smartfnb.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.smartfnb.pos",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HarmonyOS_Sans_Regular.ttf",
            "./assets/fonts/HarmonyOS_Sans_Medium.ttf",
            "./assets/fonts/HarmonyOS_Sans_Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E2A38",
          "dark": {
            "backgroundColor": "#1E2A38"
          }
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-dev-client",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f26cd467-6341-4f78-978c-34bdf0eea39f"
      }
    }
  }
}
